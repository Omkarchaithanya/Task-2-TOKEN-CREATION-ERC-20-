# .env.example - Template Configuration
# INSTRUCTIONS:
# 1. Copy this file to a new file called .env
# 2. Replace the placeholder values with YOUR OWN credentials
# 3. NEVER commit .env to version control (it contains secrets!)
# 4. Keep .env.example committed as a template for others

# ============================================
# SEPOLIA TESTNET RPC CONFIGURATION
# ============================================
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Alternative public RPC endpoints:
# - https://sepolia.infura.io/v3/{PROJECT_ID}
# - https://eth-sepolia.g.alchemy.com/v2/{PROJECT_KEY}
# - https://api.zan.top/node/v1/eth/sepolia

# ============================================
# YOUR WALLET PRIVATE KEY (REQUIRED FOR DEPLOYMENT)
# ============================================
# Format: 0x followed by 64 hexadecimal characters
# ⚠️ NEVER share this with anyone!
# ⚠️ If compromised, someone can steal your funds!
PRIVATE_KEY=0x

# How to get your private key from MetaMask:
# Step 1: Click your account icon (top right)
# Step 2: Click "Account Details"
# Step 3: Click "Show Private Key"
# Step 4: Copy the full key including "0x" prefix
# Step 5: Paste it here

# ============================================
# ETHERSCAN API KEY (OPTIONAL)
# ============================================
# Used for automatic contract verification on Etherscan
# Get it from: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ============================================
# TOKEN DETAILS
# ============================================
# These can be customized for your token
TOKEN_NAME=Task2 Token
TOKEN_SYMBOL=T2T
INITIAL_SUPPLY=1000000

